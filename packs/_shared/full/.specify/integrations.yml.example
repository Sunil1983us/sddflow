# SDD Integrations — project-level config (safe to commit — no secrets here)
# Credentials live in ~/.sdd/config.yml as env var names
#
# Setup: run "sdd config init" to generate this file interactively, or
#        copy this file to .specify/integrations.yml and fill in the values.
#
# Auth modes (configured in ~/.sdd/config.yml):
#   basic  — Atlassian Cloud: email + API token
#   pat    — Jira/Confluence Server 8.14+ / DC: Personal Access Token
#   oauth2 — Cloud CI/CD: OAuth 2.0 Bearer token

profile: default   # references a profile in ~/.sdd/config.yml

jira:
  project_key: MYPROJ

  # Issue type names for the Feature → Story → Task hierarchy.
  # Use "Epic" instead of "Feature" if your Jira project has no Feature type.
  issue_hierarchy:
    feature: Feature
    story: Story
    task: Task

  # How child issues link to their parent:
  #   "parent"            — Next-gen / team-managed projects (default)
  #   "customfield_10014" — Classic company-managed projects (Epic Link field)
  parent_field: parent

  base_fields:
    # Maps SDD MoSCoW priority to Jira priority names
    priority_map:
      must-have:   High
      should-have: Medium
      could-have:  Low
      wont-have:   Lowest
    # Labels added to every issue created by sdd
    labels: [sdd-generated]
    # fix_version: v1.0   # optional — set to target release version

  # Custom field IDs — run "sdd config fields" to discover IDs for your instance
  # Story points field ID varies by Jira version and instance:
  #   Cloud (most instances):    customfield_10016
  #   Older Cloud / Server:      customfield_10028 or customfield_10004
  custom_fields:
    story_points: customfield_10016
    # acceptance_criteria: customfield_10021
    # team:                customfield_10100

confluence:
  space_key: ENG
  # parent_page_id: "123456"   # ID of "Projects" or "Specs" page (optional)

  # Page title templates — {project} is replaced with the project name
  # from manifest.yml at push time.
  page_map:
    brd:     "{project} — Business Requirements"
    srd:     "{project} — System Requirements"
    arch:    "{project} — Architecture Overview"
    hld:     "{project} — High-Level Design"
    lld:     "{project} — Low-Level Design"
    adr:     "{project} — Architecture Decisions"
    runbook: "{project} — Runbook"
