# Copy to .env and fill in for local development / running the test suite.

DATABASE_URL="postgresql://todo_api:todo_api_dev@localhost:5432/todo_api?schema=public"

# HS256 shared secret from the (out-of-scope) Auth Service, used to verify
# incoming JWTs. In production this pack's constitution.md would list the
# real key management approach (RS256 + JWKS) — HS256 with a shared secret
# keeps this worked example runnable without standing up a second service.
JWT_SECRET="local-dev-secret-do-not-use-in-production"
