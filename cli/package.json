{
  "name": "@sunil1983us/sddflow",
  "version": "2.8.38",
  "description": "CLI for the Spec-Driven Development (SDD) Framework — initialize and upgrade AI-agent SDLC packs (Claude Code, GitHub Copilot, and any AI coding tool)",
  "type": "module",
  "bin": {
    "sdd": "bin/sdd.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node scripts/bundle-packs.js"
  },
  "files": [
    "bin/",
    "src/",
    "packs/",
    "README.md"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^15.0.0",
    "inquirer": "^14.0.2",
    "js-yaml": ">=4.1.0 <6.0.0"
  },
  "keywords": [
    "sdd",
    "spec-driven-development",
    "ai",
    "ai-agent",
    "sdlc",
    "claude",
    "claude-code",
    "copilot",
    "llm",
    "specification"
  ],
