    "name": "Sunil Kumar",
    "email": "sunil1983.us@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunil1983us/universalguide.git"
  },
  "homepage": "https://github.com/sunil1983us/universalguide",
  "bugs": {
