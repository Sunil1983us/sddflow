  "private": true,
  "description": "Worked example: TASK-001/002/003 of the SDD Framework's todo-api example, implemented for real.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern unit",
