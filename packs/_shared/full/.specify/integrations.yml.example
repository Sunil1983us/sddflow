# .specify/integrations.yml.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .specify/integrations.yml and fill in your values.
# This file is safe to commit — it contains no secrets, only env var names.
#
# Run "sdd config init" to generate this file interactively instead.
# Run "sdd config fields" to discover custom field IDs for your Jira instance.
# ─────────────────────────────────────────────────────────────────────────────

# Which auth profile to use (from ~/.sdd/config.yml).
# Run "sdd config init" to create that file.
profile: default


# ── Jira ─────────────────────────────────────────────────────────────────────

jira:
  # Your Jira project key (the prefix on issue keys, e.g. MYPROJ-123)
  # This is the default used at every hierarchy level unless overridden
  # below in project_keys.
  project_key: MYPROJ

  # Optional: per-level project key overrides, for orgs that keep
  # Features/Epics in one Jira project and Stories/Tasks in another
  # (e.g. Epic under "SUN", Story/Task under "SUNT"). Any level not
  # listed here falls back to project_key above. Valid keys:
  #   feature — the Epic/Feature created at /specify
  #   story   — dev Stories (and UC-draft placeholder Stories)
  #   task    — dev Tasks
  #   review  — the review-gate Story each `sdd review submit` creates
  #   chg     — CHG-NNN change-request tasks (see change_requests below)
  #   cr      — CR-NNN change-request review tasks (sdd cr submit)
  #
  # ⚠  IMPORTANT: Jira's parent/Epic-Link field generally does NOT
  # support linking issues across different Jira projects (this is a
  # Jira Cloud/Server platform limitation, not an SDD bug — true
  # cross-project hierarchy needs Advanced Roadmaps / Jira Premium).
  # If you override a level to a different project than its parent
  # level, the child issue will still be created, but the parent link
  # may silently fail to appear in Jira — sdd jira push always prints a
  # warning (never fails silently) when a parent link doesn't take, so
  # watch for "was not linked under" in the output after pushing.
  # project_keys:
  #   story: SUNT
  #   task: SUNT

  # Issue type names for the Feature → Story → Task hierarchy.
  #
  # These must exactly match the issue type names in your Jira project.
  # Common alternatives:
  #   feature: Epic       (if your project has no "Feature" type)
  #   task:    Sub-task   (for classic company-managed projects)
  #
  # Run: Jira → Project Settings → Issue Types to see your type names.
  issue_hierarchy:
    feature: Feature
    story: Story
    task: Task

  # How child issues link to their parent.
  #
  #   "parent"            — Next-gen / team-managed projects (default on Cloud)
  #   "customfield_10014" — Classic company-managed projects (Epic Link field)
  #
  # If you're unsure, try "parent" first. If parent links don't appear in Jira
  # after a push, switch to "customfield_10014".
  parent_field: parent

  base_fields:
    # Maps SDD MoSCoW priority labels to Jira priority names.
    # Jira priority names are case-sensitive and must match exactly.
    priority_map:
      must-have:   High
      should-have: Medium
      could-have:  Low
      wont-have:   Lowest

    # Labels added to every issue created by sdd jira push.
    # The idempotency labels (sdd:STORY-001 etc.) are added automatically
    # and do not need to be listed here.
    labels: [sdd-generated]

    # Optional: pin all issues to a Jira fix version / release.
    # Must match an existing version name in your Jira project.
    # fix_version: v1.0

  # Custom field IDs — these vary by Jira instance.
  # Run "sdd config fields" to list all custom fields for your instance.
  #
  # How to find the right ID:
  #   1. Run: sdd config fields --project MYPROJ
  #   2. Look for the field name in the output
  #   3. Copy the ID (e.g. customfield_10016) into the section below
  #
  # story_points field ID by Jira version:
  #   Jira Cloud (most instances):  customfield_10016
  #   Jira Cloud (older):           customfield_10028 or customfield_10004
  #   Jira Server / DC:             customfield_10002 (varies by config)
  custom_fields:
    story_points: customfield_10016
    # acceptance_criteria: customfield_10021
    # team:                customfield_10100
    # sprint:              customfield_10020
    #
    # Optional traceability fields — store SDD references as separate Jira
    # custom fields (in addition to the plain-text "Satisfies: ..." line
    # already in every issue's description) so you can filter/search Jira
    # by SDD reference. Only set on Story/Task/CHG when configured here.
    # fr_reference:    customfield_10101   # e.g. "FR-001, FR-002"
    # moscow_priority: customfield_10105   # e.g. "must-have"


# ── Confluence ────────────────────────────────────────────────────────────────
#
# The confluence: section works standalone — no jira: section required.
# With only confluence: configured you get:
#   - `sdd confluence push --doc {name}` (manual page create/update)
#   - automatic page updates when `sdd review approve --doc {name} --local`
#     records a chat approval (the approved .md is mirrored to its page)
# The full Jira review workflow (sdd review submit/check/apply) needs both
# jira: and confluence:.

confluence:
  # Your Confluence space key (visible in the space URL: /wiki/spaces/ENG)
  space_key: ENG

  # ID of the parent page under which all SDD pages will be created.
  # Leave commented out to create pages at the space root.
  #
  # How to find a page ID:
  #   Open the page in Confluence → ··· menu → Page Information → URL contains
  #   ?pageId=123456  ← that number is the ID
  # parent_page_id: "123456"

  # Page title templates for each SDD document type.
  # {project} is replaced with the project name from manifest.yml at push time.
  # {feature} is replaced with the active feature (or --feature override) at
  # push time — include it for any per-feature document on a multi-feature
  # project, or two features will upsert the SAME Confluence page and
  # silently overwrite each other's content. Living/service-level documents
  # (data-model, security-design, api-spec, component-library, runbook) are
  # shared across every feature by design — {feature} is ignored for those
  # even if present, so there's no harm leaving it out of their entries.
  #
  # Only documents listed here are pushed. Remove any you don't want published.
  # Add extra entries if your team uses additional document types.
  page_map:
    brd:       "{project} — Business Requirements — {feature}"
    use-cases: "{project} — Use Cases — {feature}"
    srd:       "{project} — System Requirements — {feature}"
    design:    "{project} — Design — {feature}"                 # unified plan_mode
    arch:      "{project} — Architecture Overview — {feature}"  # separate plan_mode
    hld:       "{project} — High-Level Design — {feature}"      # separate plan_mode
    adr:       "{project} — Architecture Decisions — {feature}" # separate plan_mode
    lld:       "{project} — Low-Level Design — {feature}"
    runbook:   "{project} — Runbook"                            # living — no {feature}
    # validate: "{project} — Validation Report — {feature}"
    # release:  "{project} — Release Notes — {feature}"


# ── Document review gates ─────────────────────────────────────────────────────
#
# Each SDD document has its own reviewer and must be approved before
# the next document in the phase sequence can be submitted.
#
# Sequence within each phase is enforced: you cannot submit SRD for review
# until BRD is approved; you cannot submit HLD until Arch is approved, etc.
#
# reviewer_jira_user:
#   Cloud:    use the Jira accountId (a UUID-like string)
#             Find it: Jira profile URL ends in /people/{accountId}
#   Server/DC: use the Jira username (login name)
#             Note: change "accountId" to "name" in the CLI if using Server/DC

# The doc keys below match the .md filenames — most live in
# .specify/features/{feature}/; two exceptions: `runbook` lives at
# docs/runbook/local-setup.md, and living/service-level documents
# (data-model, security-design, api-spec, component-library — shared
# across every feature in this service, see CLAUDE.md "Living
# Documents") live at .specify/service/. This example only wires up the
# main spec-phase gate (brd/use-cases/srd/design/lld/tasks/runbook/
# release) — add entries here for any other document you want a Jira/
# Confluence review gate on.
# The specify-phase sequence depends on plan_mode (manifest.yml):
#   unified  (default): BRD → Use Cases → SRD → Design       (design.md)
#   separate:           BRD → Use Cases → SRD, then in the planning phase
#                       Arch → HLD → ADR → LLD               (arch/hld/adr.md)
# The example below ships configured for UNIFIED mode. For separate mode:
# remove the design: entry and uncomment arch/hld/adr in the planning phase.

document_reviews:

  # ── specify phase (BRD → Use Cases → SRD → Design) ───────────────────────
  brd:
    reviewer_jira_user: "5c7b8a2d0f3e1a4b9d6c8f21"   # PO's Jira accountId
    reviewer_role:      Product Owner
    phase:              specify
    sequence:           1
    confluence_page:    "{project} — Business Requirements"

  use-cases:
    reviewer_jira_user: "6d8c9b3e1f4a2b5c0d7e9g32"   # BA's Jira accountId
    reviewer_role:      Business Analyst
    phase:              specify
    sequence:           2    # cannot submit until BRD approved
    confluence_page:    "{project} — Use Cases"

  srd:
    reviewer_jira_user: "6d8c9b3e1f4a2b5c0d7e9g32"   # BA's Jira accountId
    reviewer_role:      Business Analyst
    phase:              specify
    sequence:           3    # cannot submit until Use Cases approved
    confluence_page:    "{project} — System Requirements"

  design:                    # unified plan_mode only — remove for separate mode
    reviewer_jira_user: "7e9d0c4f2g5b3c6d1e8f0h43"   # Architect's accountId
    reviewer_role:      Architect
    phase:              specify
    sequence:           4    # cannot submit until SRD approved
    confluence_page:    "{project} — Design"

  # ── planning phase ────────────────────────────────────────────────────────
  # separate plan_mode only — uncomment these three (and remove design: above).
  # Order matches the prompts: /plan-arch → /plan-hld → /plan-adr → /plan-lld.
  # arch:
  #   reviewer_jira_user: "7e9d0c4f2g5b3c6d1e8f0h43"   # Architect's accountId
  #   reviewer_role:      Architect
  #   phase:              planning
  #   sequence:           1
  #   confluence_page:    "{project} — Architecture Overview"
  #
  # hld:
  #   reviewer_jira_user: "7e9d0c4f2g5b3c6d1e8f0h43"   # same Architect
  #   reviewer_role:      Architect
  #   phase:              planning
  #   sequence:           2    # cannot submit until Arch approved
  #   confluence_page:    "{project} — High-Level Design"
  #
  # adr:
  #   reviewer_jira_user: "7e9d0c4f2g5b3c6d1e8f0h43"   # Architect
  #   reviewer_role:      Architect
  #   phase:              planning
  #   sequence:           3    # cannot submit until HLD approved
  #   confluence_page:    "{project} — Architecture Decisions"

  lld:
    reviewer_jira_user: "8f0e1d5g3h6c4d7e2f9g1i54"   # Tech Lead's accountId
    reviewer_role:      Tech Lead
    phase:              planning
    sequence:           4    # separate mode: cannot submit until ADR approved;
                             # unified mode: no predecessor (arch/hld/adr absent)
    confluence_page:    "{project} — Low-Level Design"

  # ── tasks phase ──────────────────────────────────────────────────────────
  tasks:
    reviewer_jira_user: "9g1f2e6h4i7d5e8f3g0h2j65"   # Scrum Master's accountId
    reviewer_role:      Scrum Master
    phase:              tasks
    sequence:           1
    confluence_page:    "{project} — Task Breakdown"

  # ── release phase (Runbook → Release) ───────────────────────────────────
  runbook:
    reviewer_jira_user: "0h2g3f7i5j8e6f9g4h1i3k76"   # DevOps accountId
    reviewer_role:      DevOps
    phase:              release
    sequence:           1
    confluence_page:    "{project} — Runbook"

  release:
    reviewer_jira_user: "1i3h4g8j6k9f7g0h5i2j4l87"   # Release Manager accountId
    reviewer_role:      Release Manager
    phase:              release
    sequence:           2    # cannot submit until Runbook approved
    confluence_page:    "{project} — Release Notes"


# Jira task statuses that count as approval
approved_statuses: [Done, Approved]

# Comment keywords that count as approval (case-insensitive)
approved_keywords: [approved, lgtm, "looks good", "go ahead", confirmed]


# ── PR automation ─────────────────────────────────────────────────────────────
#
# Controls how "sdd pr create --task TASK-001" names branches and PRs.
#
# The git host is auto-detected from `git remote get-url origin` — no config
# needed here to pick one. Each host needs its own auth, set up once:
#
#   GitHub     — install gh CLI (https://cli.github.com), then `gh auth login`
#   GitLab     — install glab CLI (https://gitlab.com/gitlab-org/cli) and
#                `glab auth login`, OR export GITLAB_TOKEN (a personal/project
#                access token with api scope) if you don't want to install glab
#   Bitbucket  — export BITBUCKET_USERNAME and BITBUCKET_APP_PASSWORD
#                (Bitbucket → Personal settings → App passwords → Pull
#                requests: Write scope). Bitbucket has no CLI as ubiquitous
#                as gh/glab, so this is API-only.
#   Azure DevOps — install az CLI, `az extension add --name azure-devops`,
#                  then `az devops login`
#   Anything else (self-hosted git, unrecognized host) — sdd pr create still
#     creates and pushes the branch, then prints the PR title/body for you
#     to paste manually. Nothing fails silently.
#
# If the required CLI/token for your host is missing, the same manual
# fallback applies — the branch is still created and pushed.

pr_automation:
  enabled: true
  branch_pattern:    "feature/{task_id}-{slug}"
  pr_title_pattern:  "feat({task_id}): {title}"


# ── Code review ───────────────────────────────────────────────────────────────
#
# Controls the automated code review gate that runs before PR creation.
#
# pre_review: true  — agent analyses the diff, presents a checklist of findings,
#                     developer picks which to fix, fixes are applied, THEN the
#                     PR is created (with a pre-review summary in the PR body).
#
# pre_review: false — skip pre-review entirely; PR is created immediately and
#                     the human reviewer is the first reviewer of the code.
#
# After the PR is created, /address-review handles human review comments
# regardless of this setting.

code_review:
  enabled:    true
  pre_review: true
